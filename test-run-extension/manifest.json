{
  "manifest_version": 3,
  "name": "Test Run Extension",
  "short_name": "Test Run",
  "version": "0.1.0",
  "description": "Mark Test Run cases while you test, with a screenshot or a screen recording as evidence.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Test Run Extension",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"]
}
