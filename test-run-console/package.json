{
  "name": "test-run-console",
  "version": "0.1.0",
  "private": true,
  "description": "Test Run: a console for manual test runs on your .xlsx test case workbooks, with one-click marking, team sharing, a management summary and published reports. Test Run Extension is in extension/.",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "share": "node server.mjs --share",
    "demo": "node server.mjs --demo",
    "test": "node --test test/*.test.mjs extension/test/*.test.mjs",
    "prompts": "node scripts/export-prompts.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@scure/base": "^1.2.6",
    "age-encryption": "^0.2.4",
    "archiver": "^5.3.2",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.12.1",
    "jszip": "^3.10.2"
  }
}
